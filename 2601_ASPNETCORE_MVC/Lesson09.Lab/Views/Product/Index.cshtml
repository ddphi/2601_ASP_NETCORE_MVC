@model IEnumerable<Lesson09.Lab.Models.DevXuongMoc.Product>
@{
    ViewData["Title"] = "Danh sách sản phẩm";
}

<h2 class="mb-4">Danh sách sản phẩm</h2>

<div class="row">
    @foreach (var p in Model)
    {
        <div class="col-md-3 col-sm-6 mb-4">
            <div class="card h-100 shadow-sm">
                <img src="@p.Image" class="card-img-top"
                     style="height:220px; object-fit:cover;"
                     alt="@p.Title" />
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">@p.Title</h5>
                    @* <p class="card-text text-muted small">@p.Description</p> *@

                    <div class="mt-auto">
                        @if (p.PriceOld > 0)
                        {
                            <span class="text-muted text-decoration-line-through">
                                @p.PriceOld?.ToString("N0") VNĐ
                            </span>
                        }
                        <div class="text-danger fw-bold fs-5">
                            @p.PriceNew?.ToString("N0") VNĐ
                        </div>

                        <a asp-controller="Cart" asp-action="Add" asp-route-id="@p.Id">
                            Mua hàng
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>