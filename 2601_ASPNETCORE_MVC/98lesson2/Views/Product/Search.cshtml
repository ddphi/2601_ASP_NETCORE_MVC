@{
}
<div>
    <h2>Danh Sach San Pham</h2>
    <table>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Price</th>
            <th>Year</th>
        </tr>
        @foreach (var item in ViewBag.Products)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Name</td>
                <td>@item.Price</td>
                <td>@item.Year</td>
            </tr>
        }
    </table>
</div>