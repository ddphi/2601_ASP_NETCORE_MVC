@{
	ViewData["Title"] = "Cu phap razor";
}

<h1>@ViewData["Title"]</h1>
<hr/>
@{
	var total = 77000;
	decimal price = 1000.5m;
	string name = "Nguyen Van A";

}
<div class="alert alert-danger">
	<h2>cu phap razor</h2>
</div>

<div class="alert alert-success">
	<h2>cau truc if</h2>
	@{
		int age = 20;
		if (age >= 18)
		{
			<h3>Ban da du tuoi bo phieu</h3>
		}
		else
		{
			<h3>Ban chua du tuoi bo phieu</h3>
		}
	}
</div>
	
<div class="alert alert-light">
	<h2>Cau truc lap</h2>
	@{
		for(int i = 0; i < 10; i++)
		{
			if (i % 2 == 0)
			{	
				<span class="btn-danger">@i</span>
			}
			else
			{
				<span class="btn-success">@i</span>
			}
		}
	}

	@{
		var students = new List<string>() { "Nguyen Van A", "Nguyen Van B", "Nguyen Van C" };
		foreach (var student in students)
		{
			<h3 class="btn btn-primary">@student</h3>
		} 
	}
</div>
