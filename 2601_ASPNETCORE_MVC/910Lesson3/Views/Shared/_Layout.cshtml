<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - _910Lesson3</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_910Lesson3.styles.css" asp-append-version="true" />
</head>
<body>
    @await Html.PartialAsync("_pddHeaderParticalView")
    <div class="container body-content">
        <div class="row">
            <div class="col-md-2">
                @await Component.InvokeAsync("Category")
            </div>

            <div class="col-md-8">
                @RenderBody()
            </div>

            <div class="col-md-2">
                @await Component.InvokeAsync("Category", new { n = 2 })
            </div>
        </div>
    </div>

	<partial name="_pddFooterParticalView" />
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
